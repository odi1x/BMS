{
  "name": "bms-rentflow",
  "version": "0.1.0",
  "private": true,
  "description": "BMS / RentFlow — multi-tenant building & property management platform for residential associations",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "db:check-rls": "tsx --conditions=react-server scripts/rls-runtime-check.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:grant": "tsx scripts/grant-runtime-role.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.7.1",
    "imagekit": "^6.0.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "impeccable": "^4.8.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
