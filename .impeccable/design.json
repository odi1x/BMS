{
  "$schema": "impeccable/design-token-schema#1",
  "name": "اتحاد الملاك (Union of Owners)",
  "version": "1.0.0",
  "description": "Settlement-ledger design system for Saudi residential owners' associations. Grounded in the committed NoUploadPDF palette.",
  "surfaceBrief": ".impeccable/surfaces/app.md",
  "designDoc": "DESIGN.md",
  "platform": "web",
  "direction": {
    "thesis": "settlement ledger; no four-up KPI tile row; no hero banner; the tower is the screen's biggest object",
    "language": "Arabic-first RTL with complete English LTR locale",
    "currency": "SAR",
    "flat": true,
    "chromeHoldsNoColour": true
  },
  "breakpoints": {
    "mobile": 390,
    "tablet": 768,
    "desktop": 1440,
    "breakpointPx": 760
  },
  "colors": {
    "ink": "#17171a",
    "primary": "#17171a",
    "tertiary": "#007d50",
    "greenActive": "#019f68",
    "greenText": "#00673f",
    "greenTint": "#e1f8eb",
    "greenLight": "#56d298",
    "paper": "#f7f6f3",
    "neutral": "#f7f6f3",
    "surface": "#ffffff",
    "sunk": "#fbfaf8",
    "chip": "#f1efea",
    "outline": "#e4e2dc",
    "outlineStrong": "#d6d3cb",
    "divider": "#eeece7",
    "muted": "#6b6a64",
    "subtle": "#8a8880",
    "negative": "#b42318",
    "onPrimary": "#f7f6f3",
    "onTertiary": "#ffffff",
    "onSurface": "#17171a",
    "onSurfaceMuted": "#6b6a64",
    "onSurfaceSubtle": "#8a8880"
  },
  "typography": {
    "families": {
      "sans": "Instrument Sans",
      "arabic": "Noto Sans Arabic",
      "mono": "JetBrains Mono"
    },
    "title": { "family": "Instrument Sans", "size": "24px", "weight": 600, "leading": 1.2, "tracking": "-0.02em" },
    "heading": { "family": "Instrument Sans", "size": "17px", "weight": 600, "leading": 1.2, "tracking": "-0.01em" },
    "body": { "family": "Instrument Sans", "size": "14px", "weight": 400, "leading": 1.55 },
    "label": { "family": "Instrument Sans", "size": "14px", "weight": 500, "leading": 1.0 },
    "money": { "family": "JetBrains Mono", "size": "14px", "weight": 500, "leading": 1.3 },
    "meta": { "family": "Instrument Sans", "size": "12px", "weight": 400, "leading": 1.0 }
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 56],
  "components": {
    "panel": { "background": "{colors.surface}", "radius": "{radii.lg}", "padding": "24px", "border": "1px {colors.outline}", "shadow": "none" },
    "pageHeader": { "height": "64px", "background": "{colors.paper}", "shadow": "none" },
    "metricStrip": { "figure": "{typography.money}", "label": "{typography.meta}", "hint": "{typography.meta}", "toneNegative": "{colors.negative}" },
    "buttonPrimary": { "background": "{colors.ink}", "text": "{colors.onPrimary}", "radius": "{radii.md}", "padding": "14px 22px" },
    "buttonSecondary": { "background": "{colors.surface}", "text": "{colors.onSurface}", "border": "1px {colors.outlineStrong}", "radius": "{radii.md}" },
    "dataTable": { "body": "14px", "header": "12px", "zebra": false, "divider": "1px {colors.divider}" },
    "privacyPill": { "background": "{colors.greenTint}", "text": "{colors.greenText}", "dot": "6px {colors.tertiary}", "radius": "{radii.full}" },
    "settlementTower": { "width": "306px", "cellRadius": "{radii.xs}", "states": ["paid", "partial", "unpaid"] }
  },
  "accessibility": {
    "bodyContrast": "4.5:1",
    "largeTextContrast": "3:1",
    "touchTarget": "44px",
    "reducedMotion": "remove movement, keep states legible"
  },
  "meterGate": "0 FAIL; defended WARN only: palette-cream on brand ground #f7f6f3"
}
