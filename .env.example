# ─── قاعدة البيانات ────────────────────────────────────────────────
# اتركه فارغاً لتشغيل السجل التجريبي للقراءة فقط (بدون PostgreSQL).
# عند ضبطه يتحوّل التطبيق إلى وضع الكتابة الكامل عبر Prisma.
#
# Supabase: من Dashboard اضغط Connect ← "Direct connection ← Connection string"
# واختر تبويب URI. خذ سلسلتين: واحدة لوقت التشغيل وواحدة للترحيلات.
#
# DATABASE_URL — وقت التشغيل: Transaction pooler (المنفذ 6543)
#   المضيف  : aws-0-<REGION>.pooler.supabase.com   (انسخه من اللوحة، لا يمكن استنتاجه)
#   المستخدم: postgres.<PROJECT-REF>
#   pgbouncer=true إلزامي لأن الـ pooler لا يدعم العبارات المُهيّأة.
#   connection_limit=5 لأن الافتراضي (عدد أنوية المعالج × 2 + 1) يتجاوز حد اتصالات Supabase.
#
# DIRECT_URL — الترحيلات فقط (DDL): Direct connection (المنفذ 5432)
#   المضيف  : db.<PROJECT-REF>.supabase.co
#   المستخدم: postgres
#   إن كان اتصالك بالإنترنت IPv4 فقط ولم تُفعّل إضافة IPv4 في Supabase،
#   فلن يصل هذا المضيف: استخدم Session pooler بدلًا منه
#   (نفس مضيف الـ pooler لكن المنفذ 5432) — فالترحيلات تعمل عبره.
#
# رموز مثل # و ? و / في كلمة المرور يجب ترميزها قبل وضعها في الرابط (# → %23).
# افحص ملفك قبل التشغيل: npm run db:doctor
DATABASE_URL=""
DIRECT_URL=""

# ─── العزل على مستوى قاعدة البيانات ────────────────────────────────
# الدور الذي ينفّذ Prisma داخل المعاملة، وهو دور غير مالك للجداول
# حتى تُطبَّق سياسات RLS بدل أن يتجاوزها المالك.
# القيمة "none" تعطّل هذا الفصل ولا يُنصح بها إلا أثناء الترحيل.
#
# بعد تطبيق الترحيلات: GRANT app_user TO <دور الاتصال في DATABASE_URL>;
DATABASE_RUNTIME_ROLE="app_user"

# ─── الجلسات ───────────────────────────────────────────────────────
# مفتاح توقيع كوكيز الجلسة (JWT). استخدم قيمة عشوائية طويلة في الإنتاج.
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── ImageKit.io ───────────────────────────────────────────────────
# مطلوبة لتفعيل رفع الصور (ختم الجمعية، صور الشقق، صور المستخدمين).
# IMAGEKIT_PUBLIC_KEY يُستخدم في المتصفح للرفع المباشر بعد استرجاع
# معاملات المصادقة من /api/imagekit/auth.
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# ─── إرسال البريد (Resend REST API) ───────────────────────────────
# اتركها فارغة لتعطيل إرسال البريد. الروابط داخل الرسالة موقّعة
# وصلاحية محدودة بالزمن، ولا تتطلب حساباً في النظام.
RESEND_API_KEY=""
EMAIL_FROM="RentFlow <statements@example.com>"

# ─── توليد PDF ─────────────────────────────────────────────────────
# مسار Chrome/Chromium المستخدم لتحويل HTML إلى PDF.
# يُبحث عنه تلقائياً في المسارات الشائعة إن لم يُضبط.
CHROME_PATH=""
